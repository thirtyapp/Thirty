{
  "@@locale": "en",
  "brandName": "THIRTY",
  "@brandName": {
    "description": "The product name: the app title (MaterialApp.onGenerateTitle) and the name shown in the You tab's About card. A brand: never translated in any language."
  },
  "youAboutSectionTitle": "About",
  "@youAboutSectionTitle": {
    "description": "You tab: the heading of the About section, above the informational card that shows the product name and the running version. A short section heading; the section has no links or actions."
  },
  "youAboutVersion": "Version {version}",
  "@youAboutVersion": {
    "description": "You tab, About card: the line under the product name that shows which build is running. {version} is the app's version string exactly as the build reports it (digits, dots and a plus sign, e.g. major.minor.patch+build): inserted verbatim, never translated, reformatted or padded.",
    "placeholders": {
      "version": {
        "type": "String"
      }
    }
  },
  "youPageTitle": "You",
  "@youPageTitle": {
    "description": "You tab: the page's main heading, shown in the editorial serif under the THIRTY wordmark at the top of the page and announced as a heading. It names the tab (the same word as the tab's name in the bottom navigation): the person's own space in the app, not an account or profile."
  },
  "youPageSubtitle": "Your space in THIRTY.",
  "@youPageSubtitle": {
    "description": "You tab: the one-line subtitle directly under the page heading. A calm description of the page as the person's own space in the app (their experience, preferences and data), not an account. THIRTY is the product name (see brandName) and is never translated. Ends with a full stop."
  },
  "youPersonalSectionTitle": "Personal",
  "@youPersonalSectionTitle": {
    "description": "You tab: the heading of the Personal section, above the card with what is the person's own and stays on this device: their optional first name, what THIRTY remembers, the Circles they kept and their Circle history. A short section heading, announced as a heading."
  },
  "youPreferencesSectionTitle": "Preferences",
  "@youPreferencesSectionTitle": {
    "description": "You tab: the heading of the Preferences section, above the card with the app's settings: the daily reminder, appearance (theme) and, in builds that include it, spoken guidance. A short section heading, announced as a heading."
  },
  "youDataPrivacySectionTitle": "Data & privacy",
  "@youDataPrivacySectionTitle": {
    "description": "You tab: the heading of the Data & privacy section, above the card with the privacy and data controls: the usage-data choice, copying the Circle history as text, and deleting the Circle history. A short section heading, announced as a heading; the ampersand is part of the heading."
  },
  "youPersonalMemoryTitle": "What THIRTY remembers",
  "@youPersonalMemoryTitle": {
    "description": "You tab, Personal section: the title of the row that opens the What THIRTY remembers page, where the person sees what they have told THIRTY after their Circles, need by need. The row is one button: a screen reader reads this title, a comma and the line under it (youPersonalMemoryDetail) together as one label. The same words also name that page and appear elsewhere in the app; this key is only the row on You. THIRTY is the product name (see brandName) and is never translated."
  },
  "youPersonalMemoryDetail": "What you’ve told it, need by need",
  "@youPersonalMemoryDetail": {
    "description": "You tab, Personal section: the supporting line under youPersonalMemoryTitle, saying what that page holds: what the person has told THIRTY (\"it\"), grouped need by need. Shown in smaller secondary text under youPersonalMemoryTitle; a screen reader reads it after the title and a comma, as part of the row's one label. It describes the row and is not a separate instruction or hint. Uses a typographic apostrophe (’)."
  },
  "youPersonalHistoryTitle": "Your Circles",
  "@youPersonalHistoryTitle": {
    "description": "You tab, Personal section: the title of the row that opens the person's Circle history, the dated record of their Circles kept on this device. The row is one button: a screen reader reads this title, a comma and the line under it (youPersonalHistoryDetail) together as one label. It is not the Yours row (the Circles the person chose to keep) and not the Insights heading that uses the same words; this key is only the row on You."
  },
  "youPersonalHistoryDetail": "Every Circle, as it happened",
  "@youPersonalHistoryDetail": {
    "description": "You tab, Personal section: the supporting line under youPersonalHistoryTitle, saying what the Circle history holds: each of the person's Circles, recorded as it happened. Shown in smaller secondary text under youPersonalHistoryTitle; a screen reader reads it after the title and a comma, as part of the row's one label. It describes the row and is not a separate instruction or hint."
  },
  "youAppearanceTitle": "Appearance",
  "@youAppearanceTitle": {
    "description": "You tab, Preferences section: the title of the appearance row, shown above the choice of theme (themeModeSystem, themeModeLight, themeModeDark). A short row title."
  },
  "themeModeSystem": "System",
  "@themeModeSystem": {
    "description": "You tab, appearance row: the theme choice that follows the device's own light or dark setting. One of the three theme choices under youAppearanceTitle, always in the order themeModeSystem, themeModeLight, themeModeDark. The three share one row as a segmented control when every label fits its third of the width on one line; otherwise they stack as three rows. A screen reader reads this word as the choice's label, with its selected state, inside the group announced as Theme. A single short word."
  },
  "themeModeLight": "Light",
  "@themeModeLight": {
    "description": "You tab, appearance row: the theme choice that always shows THIRTY in its light colours. One of the three theme choices under youAppearanceTitle, always in the order themeModeSystem, themeModeLight, themeModeDark. The three share one row as a segmented control when every label fits its third of the width on one line; otherwise they stack as three rows. A screen reader reads this word as the choice's label, with its selected state, inside the group announced as Theme. A single short word."
  },
  "themeModeDark": "Dark",
  "@themeModeDark": {
    "description": "You tab, appearance row: the theme choice that always shows THIRTY in its dark colours. One of the three theme choices under youAppearanceTitle, always in the order themeModeSystem, themeModeLight, themeModeDark. The three share one row as a segmented control when every label fits its third of the width on one line; otherwise they stack as three rows. A screen reader reads this word as the choice's label, with its selected state, inside the group announced as Theme. A single short word."
  },
  "youPersonalNameTitle": "Your name",
  "@youPersonalNameTitle": {
    "description": "You tab, Personal section: the title of the first-name row, shown above the line under it: the person's saved first name when they have saved one (it is optional), otherwise the prompt youPersonalNameAddPrompt. The row is one button that opens the first-name editor: a screen reader reads this title, a comma and the line shown under it (the saved first name or youPersonalNameAddPrompt) together as one label. It labels the person's name and is never the name itself. The first-name editor has its own separate title with the same words; this key is only the row on You. A short row title."
  },
  "youPersonalNameAddPrompt": "Add your name",
  "@youPersonalNameAddPrompt": {
    "description": "You tab, Personal section: the supporting prompt under youPersonalNameTitle, shown only when no first name has been saved; once the person saves a first name, it is replaced by their name exactly as they entered it. Shown in smaller accent-coloured text under youPersonalNameTitle; a screen reader reads it after the title and a comma, as part of the row's one label, and it is never announced on its own. It invites the person to add their optional first name: it is not the person's stored first name, is never saved as one and never appears in stored data."
  },
  "firstNameEditorTitle": "Your name",
  "@firstNameEditorTitle": {
    "description": "First-name editor (the dialog that opens from the Your name row on You): the dialog's title. It is shown at the top of the dialog, above firstNameEditorSupporting and the one editable first-name field, which has its own separate label. It names what the dialog lets the person edit, their optional first name; it is never the name itself and never contains what the person types. A screen reader reads it as the dialog's title. In English it has the same words as youPersonalNameTitle, the title of the Personal name row on You, but it is a different key with its own owner: translate it as the title of this dialog. A short title."
  },
  "firstNameEditorSupporting": "Used only to make THIRTY feel a little more personal.",
  "@firstNameEditorSupporting": {
    "description": "First-name editor (the dialog that opens from the Your name row on You): the supporting line shown immediately below the dialog's title, firstNameEditorTitle, and above the first-name field. It explains, calmly and without technical words, why THIRTY optionally uses a first name: only to make the app feel a little more personal. It must not suggest an account, an online profile or sign-in, or that the name is sent to or stored on a server. It is always shown while the dialog is open and never changes with what the person types: it is not a validation or error message. THIRTY is the product name and stays as it is."
  },
  "firstNameEditorRemoveNameAction": "Remove name",
  "@firstNameEditorRemoveNameAction": {
    "description": "First-name editor (the dialog that opens from the Your name row on You): the label of the quiet text button shown under the first-name field. It is displayed only when a first name already exists, that is when one is already saved on this device. Tapping it clears that optional first name stored on the device, and nothing else: it does not delete Circle history, kept Circles or any other preference. It is intentionally a quiet, non-destructive-looking preference action, never shown in a warning colour, and it has no destructive confirmation dialog: the person can add a name again at any time. It is different from the broader data-deletion actions elsewhere in THIRTY, such as deleting Circle history, and must not be translated like them. It must not be confused with youPersonalNameAddPrompt, the Personal name-row prompt that invites the person to add a name. A short button label; a screen reader reads it as a button."
  },
  "firstNameEditorSaveAction": "Save",
  "@firstNameEditorSaveAction": {
    "description": "First-name editor (the dialog that opens from the Your name row on You): the label of the action that saves the edited optional first name. It appears inside the first-name editor dialog, as its last action, after Cancel. The action is disabled when the entered value is blank (or only spaces) or otherwise invalid, such as longer than the allowed length, and enabled only for a valid name. Saving uses the existing name-storage behaviour: the name stays on this device, exactly as typed once trimmed; the keyboard Done key saves the same way. It is not the first-use onboarding action, which is separately labelled Continue. It is a short button label, not a status message or a confirmation that something was saved, and it should remain understandable whether the button is enabled or disabled, without any change to what the button does. A screen reader reads it as a button."
  },
  "firstNameEditorCancelAction": "Cancel",
  "@firstNameEditorCancelAction": {
    "description": "First-name editor (the dialog that opens from the Your name row on You): the label of the visible Cancel button in the actions of the dialog. It belongs only to this dialog and is placed before Save in the dialog actions. Tapping it closes the dialog without saving any edits: it does not remove or change the first name already stored on this device. It stays available when Save is disabled, for example while the field is blank or the name is too long. A short action label; a screen reader announces it as a button. It is not the accessibility label of the dialog background (the barrier), which has its own key, firstNameEditorDismissBarrierLabel. The two English strings currently match, but they must remain independently translatable."
  },
  "firstNameEditorDismissBarrierLabel": "Cancel",
  "@firstNameEditorDismissBarrierLabel": {
    "description": "First-name editor (the dialog that opens from the Your name row on You): the accessibility label of the modal dialog barrier, the dimmed background outside the visible content of the dialog. It is an accessibility label, not an additional visible button, and it is never shown as text. It describes the action of dismissing the modal dialog: tapping or activating the barrier closes the editor without saving any edits. It must not suggest deleting, removing or clearing the stored name. A screen reader encounters it as a separate dismissal target, after the content and actions of the dialog. It is separate from the visible Cancel button, which uses firstNameEditorCancelAction. The translation should describe the dismiss function of the barrier, even if a future language uses different wording from the visible button."
  }
}
