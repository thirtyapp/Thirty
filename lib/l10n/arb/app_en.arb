{
  "@@locale": "en",
  "brandName": "THIRTY",
  "@brandName": {
    "description": "The product name: the app title (MaterialApp.onGenerateTitle) and the name shown in the You tab's About card. A brand: never translated in any language."
  },
  "youAboutSectionTitle": "About",
  "@youAboutSectionTitle": {
    "description": "You tab: the heading of the About section, above the informational card that shows the product name and the running version. A short section heading; the section has no links or actions."
  },
  "youAboutVersion": "Version {version}",
  "@youAboutVersion": {
    "description": "You tab, About card: the line under the product name that shows which build is running. {version} is the app's version string exactly as the build reports it (digits, dots and a plus sign, e.g. major.minor.patch+build): inserted verbatim, never translated, reformatted or padded.",
    "placeholders": {
      "version": {
        "type": "String"
      }
    }
  },
  "youPageTitle": "You",
  "@youPageTitle": {
    "description": "You tab: the page's main heading, shown in the editorial serif under the THIRTY wordmark at the top of the page and announced as a heading. It names the tab (the same word as the tab's name in the bottom navigation): the person's own space in the app, not an account or profile."
  },
  "youPageSubtitle": "Your space in THIRTY.",
  "@youPageSubtitle": {
    "description": "You tab: the one-line subtitle directly under the page heading. A calm description of the page as the person's own space in the app (their experience, preferences and data), not an account. THIRTY is the product name (see brandName) and is never translated. Ends with a full stop."
  },
  "youPersonalSectionTitle": "Personal",
  "@youPersonalSectionTitle": {
    "description": "You tab: the heading of the Personal section, above the card with what is the person's own and stays on this device: their optional first name, what THIRTY remembers, the Circles they kept and their Circle history. A short section heading, announced as a heading."
  },
  "youPreferencesSectionTitle": "Preferences",
  "@youPreferencesSectionTitle": {
    "description": "You tab: the heading of the Preferences section, above the card with the app's settings: the daily reminder, appearance (theme) and, in builds that include it, spoken guidance. A short section heading, announced as a heading."
  },
  "youDataPrivacySectionTitle": "Data & privacy",
  "@youDataPrivacySectionTitle": {
    "description": "You tab: the heading of the Data & privacy section, above the card with the privacy and data controls: the usage-data choice, copying the Circle history as text, and deleting the Circle history. A short section heading, announced as a heading; the ampersand is part of the heading."
  },
  "youPersonalMemoryTitle": "What THIRTY remembers",
  "@youPersonalMemoryTitle": {
    "description": "You tab, Personal section: the title of the row that opens the What THIRTY remembers page, where the person sees what they have told THIRTY after their Circles, need by need. The row is one button: a screen reader reads this title, a comma and the line under it (youPersonalMemoryDetail) together as one label. The same words also name that page and appear elsewhere in the app; this key is only the row on You. THIRTY is the product name (see brandName) and is never translated."
  },
  "youPersonalMemoryDetail": "What you’ve told it, need by need",
  "@youPersonalMemoryDetail": {
    "description": "You tab, Personal section: the supporting line under youPersonalMemoryTitle, saying what that page holds: what the person has told THIRTY (\"it\"), grouped need by need. Shown in smaller secondary text under youPersonalMemoryTitle; a screen reader reads it after the title and a comma, as part of the row's one label. It describes the row and is not a separate instruction or hint. Uses a typographic apostrophe (’)."
  },
  "youPersonalHistoryTitle": "Your Circles",
  "@youPersonalHistoryTitle": {
    "description": "You tab, Personal section: the title of the row that opens the person's Circle history, the dated record of their Circles kept on this device. The row is one button: a screen reader reads this title, a comma and the line under it (youPersonalHistoryDetail) together as one label. It is not the Yours row (the Circles the person chose to keep) and not the Insights heading that uses the same words; this key is only the row on You."
  },
  "youPersonalHistoryDetail": "Every Circle, as it happened",
  "@youPersonalHistoryDetail": {
    "description": "You tab, Personal section: the supporting line under youPersonalHistoryTitle, saying what the Circle history holds: each of the person's Circles, recorded as it happened. Shown in smaller secondary text under youPersonalHistoryTitle; a screen reader reads it after the title and a comma, as part of the row's one label. It describes the row and is not a separate instruction or hint."
  },
  "youAppearanceTitle": "Appearance",
  "@youAppearanceTitle": {
    "description": "You tab, Preferences section: the title of the appearance row, shown above the choice of theme (themeModeSystem, themeModeLight, themeModeDark). A short row title."
  },
  "themeModeSystem": "System",
  "@themeModeSystem": {
    "description": "You tab, appearance row: the theme choice that follows the device's own light or dark setting. One of the three theme choices under youAppearanceTitle, always in the order themeModeSystem, themeModeLight, themeModeDark. The three share one row as a segmented control when every label fits its third of the width on one line; otherwise they stack as three rows. A screen reader reads this word as the choice's label, with its selected state, inside the group announced as Theme. A single short word."
  },
  "themeModeLight": "Light",
  "@themeModeLight": {
    "description": "You tab, appearance row: the theme choice that always shows THIRTY in its light colours. One of the three theme choices under youAppearanceTitle, always in the order themeModeSystem, themeModeLight, themeModeDark. The three share one row as a segmented control when every label fits its third of the width on one line; otherwise they stack as three rows. A screen reader reads this word as the choice's label, with its selected state, inside the group announced as Theme. A single short word."
  },
  "themeModeDark": "Dark",
  "@themeModeDark": {
    "description": "You tab, appearance row: the theme choice that always shows THIRTY in its dark colours. One of the three theme choices under youAppearanceTitle, always in the order themeModeSystem, themeModeLight, themeModeDark. The three share one row as a segmented control when every label fits its third of the width on one line; otherwise they stack as three rows. A screen reader reads this word as the choice's label, with its selected state, inside the group announced as Theme. A single short word."
  }
}
