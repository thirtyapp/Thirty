+/// R8.3.2 (Astra R83-N01, Claude AUD-R83-3): which Start was made while its
+/// Plan was paused ([PlanProgress.startedWhilePaused]) — the Circle and the
+/// very instant of that Start, the instant its session is then saved with.
+///
+/// Written, and confirmed, before that Start is valid (founder decision B),
+/// so a record can outlive a Start that never happened: the app stopped,
+/// the Start's own save failed, or it was cancelled. Such a record names an
+/// instant no saved session has, and excludes nothing; a later valid Start
+/// of the same Circle has an instant of its own.
+///
+/// A record written by R8.3.1 names the Circle only ([startedAt] `null`):
+/// it still excludes every Start of that Circle, as it did then.
+class PausedStart {
+  const PausedStart({required this.circleId, this.startedAt, this.extra});
+
+  final String circleId;
+
+  /// The Start's instant (UTC, ISO 8601); `null` only for an R8.3.1 record.
+  final String? startedAt;
+
+  /// The fields of a stored record this build doesn't know, written back
+  /// as stored (R8.1 RL-3).
+  final Map<String, Object?>? extra;
+
+  /// Whether this record excludes [circleId]'s Start at [at] from Plan
+  /// credit: the same Circle, and the same Start — or a Start this can't
+  /// tell apart from it (an R8.3.1 record, or no instant to compare).
+  bool excludes(String circleId, DateTime? at) =>
+      circleId == this.circleId &&
+      (startedAt == null ||
+          at == null ||
+          ServedStageCircle.sameInstant(startedAt, at));
+
+  Object toJson() => startedAt == null
+      ? circleId
+      : {...?extra, 'circleId': circleId, 'startedAt': startedAt};
+
+  /// `null` for anything that isn't a whole record: a Circle that isn't a
+  /// day, or an instant that isn't one (Astra's post-R8.3 §7 observation:
+  /// never read as an exclusion that matches nothing). The Plan is then
+  /// kept as stored.
+  static PausedStart? fromJson(Object? raw) {
+    if (raw is String) {
+      return isCanonicalDateKey(raw) ? PausedStart(circleId: raw) : null;
+    }
+    if (raw is! Map<String, Object?>) return null;
+    final circleId = raw['circleId'];
+    final at = raw['startedAt'];
+    if (circleId is! String || !isCanonicalDateKey(circleId)) return null;
+    if (at is! String || DateTime.tryParse(at) == null) return null;
+    return PausedStart(
+      circleId: circleId,
+      startedAt: at,
+      extra: {
+        for (final MapEntry(:key, :value) in raw.entries)
+          if (key != 'circleId' && key != 'startedAt') key: value,
+      },
+    );
+  }
+}
